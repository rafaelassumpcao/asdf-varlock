#!/usr/bin/env bash
set -euo pipefail

fail() {
	echo -e "asdf-varlock: $1" >&2
	exit 1
}

install_version() {
	local install_type="$1"
	local install_path="$2"
	local download_path="$3"

	[ "$install_type" = "version" ] || fail "asdf-varlock supports release versions only"
	[ -f "${download_path}/varlock" ] || fail "varlock binary not found in ${download_path} (download step may have failed)"

	mkdir -p "${install_path}/bin"
	cp "${download_path}/varlock" "${install_path}/bin/varlock"
	chmod +x "${install_path}/bin/varlock"

	"${install_path}/bin/varlock" --version >/dev/null 2>&1 \
		|| fail "installed binary failed to run"
}

install_version "$ASDF_INSTALL_TYPE" "$ASDF_INSTALL_PATH" "$ASDF_DOWNLOAD_PATH"
