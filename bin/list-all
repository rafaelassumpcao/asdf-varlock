#!/usr/bin/env bash
set -euo pipefail

GH_REPO="dmno-dev/varlock"

# Release tags for the core CLI look like "varlock@1.13.0"; the monorepo
# also cuts releases for sibling packages (e.g. "@varlock/hashicorp-vault-plugin@2.1.0"),
# so filter strictly on the "varlock@" prefix.
list_all_versions() {
	git ls-remote --tags "https://github.com/${GH_REPO}.git" \
		| grep -o 'refs/tags/varlock@.*' \
		| sed 's|refs/tags/varlock@||' \
		| sed 's/\^{}//' \
		| grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' \
		| sort -u -V
}

list_all_versions
